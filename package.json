{
  "name": "pi-subagents-workflows",
  "version": "0.1.0",
  "description": "Saved workflow registry and runner for pi-subagents workflowScript orchestration",
  "author": "Eli <i@whitehat.com.ua>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/white-hat/pi-subagents-workflows.git"
  },
  "homepage": "https://github.com/white-hat/pi-subagents-workflows#readme",
  "bugs": {
    "url": "https://github.com/white-hat/pi-subagents-workflows/issues"
  },
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src/",
    "skills/",
    "workflows/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-subagents",
    "workflows",
    "orchestration"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
